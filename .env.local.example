# Copy to .env.local and fill in the SAME values as the existing "hello_world" app
# (find them in that project's Vercel settings, or Supabase > Project Settings > API).
# The admin area uses ONLY the public anon key — access is enforced by Supabase RLS +
# the is_superadmin check, so no service-role key is needed.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
